// ===============================================
// صفحة حساب المعدل
// ===============================================

function Admission() {

  const navigate = useNavigate();

  const [subjects, setSubjects] = useState([
    { name: "", grade: "" }
  ]);

  const addSubject = () => {

    setSubjects([
      ...subjects,
      { name: "", grade: "" }
    ]);

  };

  const handleChange = (index, field, value) => {

    const updated = [...subjects];

    updated[index][field] = value;

    setSubjects(updated);

  };

  const calculate = () => {

    let total = 0;

    subjects.forEach((s) => {
      total += Number(s.grade);
    });

    const avg = total / subjects.length;

    localStorage.setItem("average", avg);

    navigate("/universities");

  };

  return (

    <div className="min-h-screen bg-blue-50 p-10">

      <h1 className="text-5xl font-bold text-center mb-10">
        حساب المعدل التنافسي
      </h1>

      <div className="max-w-4xl mx-auto">

        {subjects.map((subject, index) => (

          <div key={index} className="grid grid-cols-2 gap-4 mb-4">

            <input
              placeholder="اسم المادة"
              className="p-4 rounded-xl"
              onChange={(e) =>
                handleChange(index, "name", e.target.value)
              }
            />

            <input
              type="number"
              placeholder="الدرجة"
              className="p-4 rounded-xl"
              onChange={(e) =>
                handleChange(index, "grade", e.target.value)
              }
            />

          </div>

        ))}

        <div className="flex gap-4 mt-6">

          <button
            onClick={addSubject}
            className="bg-green-600 text-white px-6 py-4 rounded-2xl"
          >
            إضافة مادة
          </button>

          <button
            onClick={calculate}
            className="bg-blue-700 text-white px-6 py-4 rounded-2xl"
          >
            حساب المعدل
          </button>

        </div>

      </div>

    </div>

  );

}

